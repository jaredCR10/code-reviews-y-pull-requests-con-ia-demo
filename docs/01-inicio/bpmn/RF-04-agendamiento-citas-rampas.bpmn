<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RF04" targetNamespace="http://bizagi.com/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Recepcion" name="Recepción (Don Chepe)" processRef="Process_Recepcion_RF04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Recepcion_RF04" name="Recepción (Don Chepe)" isExecutable="false">
    <bpmn:startEvent id="R0" name="Solicitud de atención generada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="R1" name="Recibir solicitud de cita o llegada del cliente">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="R2" name="Anotar la cita en la pizarra física">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="R3" name="¿Hay rampa disponible a la hora solicitada?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Si</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="R4a" name="Confirmar la cita y recibir el vehículo">
      <bpmn:incoming>Flow_Si</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="R5" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="R6" name="Comunicar el estado de atención al cliente">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="R7" name="Cita gestionada">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="R4b" name="Parquear el vehículo en la vía pública en espera de rampa">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="R0" targetRef="R1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="R1" targetRef="R2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="R2" targetRef="R3" />
    <bpmn:sequenceFlow id="Flow_Si" name="Sí" sourceRef="R3" targetRef="R4a" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="R3" targetRef="R4b" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="R4a" targetRef="R5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="R4b" targetRef="R5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="R5" targetRef="R6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="R6" targetRef="R7" />
  </bpmn:process>
