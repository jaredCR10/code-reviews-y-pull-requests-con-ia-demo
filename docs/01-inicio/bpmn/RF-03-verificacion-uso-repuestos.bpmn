<bpmn:startEvent id="M0" name="Orden de reparación asignada"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="M1" name="Subir el vehículo a la rampa asumiendo repuesto disponible"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="M2" name="Iniciar el desarme para cambiar el repuesto"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="M3" name="¿Hay unidades disponibles del repuesto en el estante?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_Si</bpmn:outgoing><bpmn:outgoing>Flow_No</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="M4a" name="Detener el trabajo técnico"><bpmn:incoming>Flow_No</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="M4b" name="Comprar el repuesto de emergencia en la repuestera local"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="M5" name=""><bpmn:incoming>Flow_Si</bpmn:incoming><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="M6" name="Continuar la reparación con el repuesto disponible"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:manualTask>
<bpmn:endEvent id="M7" name="Reparación completada"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
