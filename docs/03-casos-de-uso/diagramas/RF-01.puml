@startuml rf-01-historial-vehicular
' Generado por generar_diagramas_cu.py a partir de la matriz 7.0.2. No editar a mano.
left to right direction
skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 20
skinparam ranksep 120
skinparam ArrowColor #444444
skinparam ArrowFontSize 11
skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F3A5F
skinparam UsecaseFontSize 11
skinparam RectangleBorderColor #1F3A5F
skinparam RectangleBackgroundColor #FFFFFF

title RF-01 Historial vehicular\nCasos de uso: CU-06, CU-01, CU-11

actor "Administrador\ndel Taller" as ADM
actor "Mecánico" as MEC
actor "Cliente" as CLI
ADM -[hidden]right- MEC
rectangle "Frontera del sistema: TallerAuto" as SYS {
  usecase "CU-04\nAgendar Cita de\nMantenimiento" as CU04 #EDEDED
  usecase "CU-07\nRegistrar Llegada de\nVehículo sin Cita" as CU07 #EDEDED
  usecase "CU-06\nRegistrar Vehículo" as CU06 #FFE9A8
  usecase "CU-01\nConsultar Historial\nVehicular por Placa" as CU01 #FFE9A8
  usecase "CU-11\nRegistrar Servicio y\nCerrar Orden de Trabajo" as CU11 #FFE9A8
}

CU04 -[hidden]right- CU07
CU07 -[hidden]right- CU06
CU06 -[hidden]right- CU01
CU01 -[hidden]right- CU11

ADM -down- CU06
MEC -down- CU06
CU06 -down-> CLI
ADM -down- CU01
MEC -down- CU01
CU01 -down-> CLI
ADM -down- CU11
MEC -down- CU11

CU06 .right.> CU01 : <<extend>>
CU06 .left.> CU04 : <<extend>>
CU06 .left.> CU07 : <<extend>>

legend bottom
  CU-06 extiende a CU-01 en el punto de extensión "placa no registrada"
  CU-06 extiende a CU-04 en el punto de extensión "placa no registrada"
  CU-06 extiende a CU-07 en el punto de extensión "placa no registrada"
endlegend
@enduml
